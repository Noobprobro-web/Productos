<div class="announcement-bar">
  {{ section.settings.announcement_text | default: "✨ Envíos gratis a todo el país en compras superiores a $50 | 100% Ecológico y Sostenible" }}
</div>

<header class="site-header">
  <div class="container header-inner">
    <a href="{{ routes.root_url }}" class="logo">
      {%- if section.settings.logo_text != blank -%}
        {{ section.settings.logo_text }}<span>.</span>
      {%- else -%}
        ATELIER<span>.</span>
      {%- endif -%}
    </a>
    <nav class="main-nav">
      <ul>
        {%- for link in section.settings.menu.links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {%- else -%}
          <li><a href="#hero">Inicio</a></li>
          <li><a href="#mas-vendidos">Más Vendidos</a></li>
          <li><a href="#categorias">Categorías</a></li>
          <li><a href="#reseñas">Reseñas</a></li>
        {%- endfor -%}
      </ul>
    </nav>
    <div class="header-actions">
      <button class="icon-btn" aria-label="Buscar">
        <svg class="icon-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>
      <a href="{{ routes.cart_url }}" class="icon-btn" aria-label="Carrito">
        <svg class="icon-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header & Barra Superior",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Texto del anuncio",
      "default": "✨ Envíos gratis a todo el país en compras superiores a $50 | 100% Ecológico y Sostenible"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Texto del Logo",
      "default": "ATELIER"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menú principal"
    }
  ]
}
{% endschema %}
