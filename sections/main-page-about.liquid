<div class="container" style="padding: 4rem 1.5rem;">
  <div class="about-hero-text">
    <h1 class="title-1">{{ page.title | default: "Quiénes Somos" }}</h1>
    <h2 class="title-2">{{ section.settings.intro_title | default: "Creemos en la belleza de lo esencial" }}</h2>
  </div>

  <div class="about-grid" style="margin-top: 3rem;">
    <div class="about-content">
      <h3 class="title-3">Nuestra Filosofía Atelier</h3>
      <p class="text-body">
        {{ section.settings.intro_text_1 | default: "Atelier nació de la firme creencia de que nuestro entorno físico influye directamente en nuestro bienestar mental. Eliminamos el ruido visual sobrante para ofrecer piezas con propósito, geometría limpia y materiales responsables." }}
      </p>
      <p class="text-body">
        {{ section.settings.intro_text_2 | default: "Nuestra paleta inspirada en verde suave y marrón tierra busca conectar tu espacio interior con la serenidad de la naturaleza." }}
      </p>
    </div>

    <div class="about-media">
      {% if section.settings.intro_image != blank %}
        <img src="{{ section.settings.intro_image | image_url: width: 600 }}" alt="Taller Atelier" loading="lazy" style="border-radius: var(--radius-md); width:100%;">
      {% else %}
        <div class="placeholder-box" style="min-height: 320px;">
          <p>IMAGEN DEL TALLER / EQUIPO</p>
          <span>Fotografía artesanal en tonos pastel</span>
        </div>
      {% endif %}
    </div>
  </div>

  <!-- Timeline Section -->
  <div class="about-timeline" style="margin-top: 5rem;">
    <div class="section-header" style="text-align: center;">
      <h2 class="title-2">Nuestra Trayectoria</h2>
      <h3 class="title-3">El camino hacia la simplicidad</h3>
    </div>

    <div class="timeline-grid" style="margin-top: 3rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 2rem;">
      <div class="timeline-card" style="background: var(--color-surface); padding: 2rem; border-radius: var(--radius-md); border: 1px solid rgba(0,0,0,0.05);">
        <span style="font-family: var(--font-heading); font-size: 2rem; font-weight: 700; color: var(--color-green-dark);">2022</span>
        <h3 class="title-3" style="margin-top: 0.5rem;">El Origen</h3>
        <p class="text-body" style="font-size: 0.9rem;">Fundación del primer taller de artesanía funcional enfocada en tonos naturales.</p>
      </div>

      <div class="timeline-card" style="background: var(--color-surface); padding: 2rem; border-radius: var(--radius-md); border: 1px solid rgba(0,0,0,0.05);">
        <span style="font-family: var(--font-heading); font-size: 2rem; font-weight: 700; color: var(--color-green-dark);">2024</span>
        <h3 class="title-3" style="margin-top: 0.5rem;">Expansión Verde</h3>
        <p class="text-body" style="font-size: 0.9rem;">Lanzamiento de las líneas de decoración, textiles orgánicos y cuidado personal.</p>
      </div>

      <div class="timeline-card" style="background: var(--color-surface); padding: 2rem; border-radius: var(--radius-md); border: 1px solid rgba(0,0,0,0.05);">
        <span style="font-family: var(--font-heading); font-size: 2rem; font-weight: 700; color: var(--color-green-dark);">2026</span>
        <h3 class="title-3" style="margin-top: 0.5rem;">Comunidad Global</h3>
        <p class="text-body" style="font-size: 0.9rem;">Más de 20 categorías y 400 productos pensados para enriquecer cada hogar.</p>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Quiénes Somos",
  "settings": [
    {
      "type": "text",
      "id": "intro_title",
      "label": "Título Principal",
      "default": "Creemos en la belleza de lo esencial"
    },
    {
      "type": "textarea",
      "id": "intro_text_1",
      "label": "Párrafo 1",
      "default": "Atelier nació de la firme creencia de que nuestro entorno físico influye directamente en nuestro bienestar mental."
    },
    {
      "type": "textarea",
      "id": "intro_text_2",
      "label": "Párrafo 2",
      "default": "Nuestra paleta inspirada en verde suave y marrón tierra busca conectar tu espacio interior con la serenidad de la naturaleza."
    },
    {
      "type": "image_picker",
      "id": "intro_image",
      "label": "Imagen del Taller"
    }
  ],
  "presets": [
    {
      "name": "Quiénes Somos"
    }
  ]
}
{% endschema %}
