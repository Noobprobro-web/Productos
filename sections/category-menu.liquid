<section id="categorias" class="section-categories">
  <div class="container">
    <div class="section-header">
      <h2 class="title-2">{{ section.settings.title_2 | default: "Explora Nuestras 20 Categorías" }}</h2>
      <h3 class="title-3">{{ section.settings.title_3 | default: "20 productos meticulosamente seleccionados por cada línea" }}</h3>
      <p class="text-body">{{ section.settings.text_body | default: "Navega a través de nuestro universo completo de 400 productos sostenibles." }}</p>
    </div>

    <div class="categories-grid-extended">
      {%- if collections.size > 0 and section.settings.use_shopify_collections -%}
        {%- for collection in collections limit: 20 -%}
          <div class="category-card">
            <div class="category-card-content" style="padding: 1.5rem; text-align: center;">
              <h3 class="title-3" style="font-size: 1.25rem; font-weight: 600; color: var(--color-dark); margin-bottom: 0.4rem;">{{ collection.title }}</h3>
              <p class="text-body" style="font-size: 0.85rem; color: var(--color-text-muted);">{{ collection.products_count | default: 20 }} Productos disponible</p>
            </div>
            <a href="{{ collection.url }}" class="category-card-link" style="position: absolute; inset:0;" aria-label="{{ collection.title }}"></a>
          </div>
        {%- endfor -%}
      {%- else -%}
        {% for block in section.blocks %}
          <div class="category-card" {{ block.shopify_attributes }}>
            <div class="category-card-content" style="padding: 1.5rem; text-align: center;">
              <h3 class="title-3" style="font-size: 1.25rem; font-weight: 600; color: var(--color-dark); margin-bottom: 0.4rem;">{{ block.settings.title_3 | default: block.settings.collection.title | default: "Nombre Categoría" }}</h3>
              <p class="text-body" style="font-size: 0.85rem; color: var(--color-text-muted);">{{ block.settings.item_count_text | default: "20 Productos disponible" }}</p>
            </div>
            <a href="{{ block.settings.collection.url | default: block.settings.link | default: routes.all_products_collection_url }}" class="category-card-link" style="position: absolute; inset:0;" aria-label="{{ block.settings.title_3 }}"></a>
          </div>
        {% else %}
          {% assign default_cats = "Decoración y Hogar|Textiles Orgánicos|Cuidado Personal|Velas y Aromaterapia|Accesorios de Bambú|Iluminación Cálida|Vajillas de Cerámica|Organizadores de Madera|Papelería Minimalista|Macetas y Jardines|Baño y Relax|Cocina Sustentable|Movilidad & Botellas|Arte y Cuadros Botánicos|Muebles Auxiliares|Calzado y Confort|Infusiones y Té Orgánico|Accesorios para Mascotas|Juguetes de Madera|Cuidado de la Ropa" | split: "|" %}
          {% for cat in default_cats %}
            <div class="category-card">
              <div class="category-card-content" style="padding: 1.5rem; text-align: center;">
                <h3 class="title-3" style="font-size: 1.25rem; font-weight: 600; color: var(--color-dark); margin-bottom: 0.4rem;">{{ cat }}</h3>
                <p class="text-body" style="font-size: 0.85rem; color: var(--color-text-muted);">20 Productos disponible</p>
              </div>
              <a href="{{ routes.all_products_collection_url }}" class="category-card-link" style="position: absolute; inset:0;" aria-label="{{ cat }}"></a>
            </div>
          {% endfor %}
        {% endfor %}
      {%- endif -%}
    </div>

    {% if section.settings.show_all_button %}
      <div style="text-align: center; margin-top: 3rem;">
        <a href="{{ section.settings.all_button_link | default: routes.collections_url }}" class="btn btn-primary">
          {{ section.settings.all_button_text | default: "Ver Catálogo Completo →" }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

