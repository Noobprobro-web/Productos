<section id="categorias" class="section-categories">
  <div class="container">
    <div class="section-header">
      <h2 class="title-2">{{ section.settings.title_2 | default: "Explora por Categorías" }}</h2>
      <h3 class="title-3">{{ section.settings.title_3 | default: "Encuentra exactamente lo que necesitas para tu espacio" }}</h3>
      <p class="text-body">{{ section.settings.text_body | default: "Navega a través de nuestras colecciones diseñadas minuciosamente." }}</p>
    </div>

    <div class="categories-grid">
      {% for block in section.blocks %}
        <div class="category-card" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title_3 }}" loading="lazy" style="border-radius: var(--radius-md); height: 200px; object-fit: cover;">
          {% else %}
            <div class="placeholder-box">
              <p>IMAGEN DE LA CATEGORÍA</p>
              <span>Fondo de la sección / Banner {{ block.settings.title_3 }}</span>
            </div>
          {% endif %}
          <div class="category-footer">
            <div>
              <h3 class="title-3">{{ block.settings.title_3 | default: "Nombre Categoría" }}</h3>
              <p class="text-body" style="font-size: 0.85rem;">{{ block.settings.item_count_text | default: "Colección Destacada" }}</p>
            </div>
            <a href="{{ block.settings.link | default: '#' }}" class="btn btn-outline" style="padding: 0.5rem 1rem;">Ver Más →</a>
          </div>
        </div>
      {% else %}
        <!-- Fallback static blocks -->
        <div class="category-card">
          <div class="placeholder-box">
            <p>IMAGEN DE LA CATEGORÍA</p>
            <span>Fondo de la sección / Banner categoría 1</span>
          </div>
          <div class="category-footer">
            <div>
              <h3 class="title-3">Decoración y Hogar</h3>
              <p class="text-body" style="font-size: 0.85rem;">12 Productos</p>
            </div>
            <a href="#" class="btn btn-outline" style="padding: 0.5rem 1rem;">Ver Más →</a>
          </div>
        </div>
        <div class="category-card">
          <div class="placeholder-box">
            <p>IMAGEN DE LA CATEGORÍA</p>
            <span>Fondo de la sección / Banner categoría 2</span>
          </div>
          <div class="category-footer">
            <div>
              <h3 class="title-3">Cuidado Personal</h3>
              <p class="text-body" style="font-size: 0.85rem;">8 Productos</p>
            </div>
            <a href="#" class="btn btn-outline" style="padding: 0.5rem 1rem;">Ver Más →</a>
          </div>
        </div>
        <div class="category-card">
          <div class="placeholder-box">
            <p>IMAGEN DE LA CATEGORÍA</p>
            <span>Fondo de la sección / Banner categoría 3</span>
          </div>
          <div class="category-footer">
            <div>
              <h3 class="title-3">Textiles Esenciales</h3>
              <p class="text-body" style="font-size: 0.85rem;">15 Productos</p>
            </div>
            <a href="#" class="btn btn-outline" style="padding: 0.5rem 1rem;">Ver Más →</a>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "4. Menú de Categorías",
  "settings": [
    {
      "type": "text",
      "id": "title_2",
      "label": "Título 2 (H2 Principal)",
      "default": "Explora por Categorías"
    },
    {
      "type": "text",
      "id": "title_3",
      "label": "Título 3 (H3 Subtítulo)",
      "default": "Encuentra exactamente lo que necesitas para tu espacio"
    },
    {
      "type": "textarea",
      "id": "text_body",
      "label": "Texto Informativo",
      "default": "Navega a través de nuestras colecciones diseñadas minuciosamente."
    }
  ],
  "blocks": [
    {
      "type": "category_item",
      "name": "Tarjeta de Categoría",
      "settings": [
        {
          "type": "text",
          "id": "title_3",
          "label": "Título 3 de Categoría",
          "default": "Nueva Categoría"
        },
        {
          "type": "text",
          "id": "item_count_text",
          "label": "Texto secundario o cantidad",
          "default": "10 Productos"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen de fondo de la categoría"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace de la categoría"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "4. Menú de Categorías",
      "blocks": [
        { "type": "category_item", "settings": { "title_3": "Decoración y Hogar", "item_count_text": "12 Productos" } },
        { "type": "category_item", "settings": { "title_3": "Cuidado Personal", "item_count_text": "8 Productos" } },
        { "type": "category_item", "settings": { "title_3": "Textiles Esenciales", "item_count_text": "15 Productos" } }
      ]
    }
  ]
}
{% endschema %}
