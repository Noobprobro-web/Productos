<section id="reseñas" class="section-reviews">
  <div class="container">
    <div class="section-header">
      <h2 class="title-2">{{ section.settings.title_2 | default: "Lo que Dicen Nuestros Clientes" }}</h2>
      <h3 class="title-3">{{ section.settings.title_3 | default: "Experiencias reales con nuestros productos" }}</h3>
      <p class="text-body">{{ section.settings.text_body | default: "La satisfacción de quienes ya disfrutan de nuestra colección minimalista." }}</p>
    </div>

    <div class="reviews-grid">
      {% for block in section.blocks %}
        <article class="review-card" {{ block.shopify_attributes }}>
          <div class="stars">
            {% assign rating = block.settings.star_rating | default: 5 %}
            {% for i in (1..rating) %}★{% endfor %}
          </div>
          <h3 class="title-3">{{ block.settings.title_3 | default: "Calidad y elegancia pura" }}</h3>
          <p class="review-text">"{{ block.settings.review_text | default: "El producto superó mis expectativas. El tono pastel verde es idéntico a las fotos." }}"</p>
          <div class="author-info">
            {% if block.settings.author_image != blank %}
              <img src="{{ block.settings.author_image | image_url: width: 100 }}" alt="{{ block.settings.author_name }}" style="width: 42px; height: 42px; border-radius: 50%; object-fit: cover;">
            {% else %}
              <div class="author-avatar">{{ block.settings.author_initials | default: "MC" }}</div>
            {% endif %}
            <div class="author-details">
              <p>{{ block.settings.author_name | default: "Cliente Verificado" }}</p>
              <span>{{ block.settings.author_badge | default: "Comprador Verificado" }}</span>
            </div>
          </div>
        </article>
      {% else %}
        {% for i in (1..3) %}
          <article class="review-card">
            <div class="stars">★★★★★</div>
            <h3 class="title-3">Reseña Destacada {{ i }}</h3>
            <p class="review-text">"Excelente calidad y diseño minimalista en tonos pastel. Recomendado 100%."</p>
            <div class="author-info">
              <div class="author-avatar">CL</div>
              <div class="author-details">
                <p>Cliente {{ i }}</p>
                <span>Cliente Verificado</span>
              </div>
            </div>
          </article>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "5. Reseñas de la Web",
  "settings": [
    {
      "type": "text",
      "id": "title_2",
      "label": "Título 2 (H2 Principal)",
      "default": "Lo que Dicen Nuestros Clientes"
    },
    {
      "type": "text",
      "id": "title_3",
      "label": "Título 3 (H3 Subtítulo)",
      "default": "Experiencias reales con nuestros productos"
    },
    {
      "type": "textarea",
      "id": "text_body",
      "label": "Texto Descriptivo",
      "default": "La satisfacción de quienes ya disfrutan de nuestra colección minimalista."
    }
  ],
  "blocks": [
    {
      "type": "review_item",
      "name": "Reseña Editable",
      "settings": [
        {
          "type": "range",
          "id": "star_rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5,
          "label": "Valoración en Estrellas"
        },
        {
          "type": "text",
          "id": "title_3",
          "label": "Título de la Reseña",
          "default": "Calidad y elegancia pura"
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Contenido de la Reseña",
          "default": "El producto superó mis expectativas. El tono pastel es idéntico a las fotos."
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Nombre del Cliente",
          "default": "María Camila R."
        },
        {
          "type": "text",
          "id": "author_initials",
          "label": "Iniciales para Avatar (si no hay foto)",
          "default": "MC"
        },
        {
          "type": "image_picker",
          "id": "author_image",
          "label": "Foto del Cliente (Opcional)"
        },
        {
          "type": "text",
          "id": "author_badge",
          "label": "Etiqueta del Cliente",
          "default": "Cliente Verificado"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "5. Reseñas de la Web",
      "blocks": [
        { "type": "review_item", "settings": { "title_3": "Calidad y elegancia pura", "author_name": "María Camila R.", "author_initials": "MC" } },
        { "type": "review_item", "settings": { "title_3": "Textiles increíbles", "author_name": "Javier G.", "author_initials": "JG" } },
        { "type": "review_item", "settings": { "title_3": "Excelente atención y empaque", "author_name": "Sofia L.", "author_initials": "SL" } }
      ]
    }
  ]
}
{% endschema %}
